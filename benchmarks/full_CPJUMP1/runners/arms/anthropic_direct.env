# Sourced as $ARM_ENV AFTER the repo .env (run_staged.sh), so it wins. Routes a claude-* reasoner to
# Anthropic-DIRECT (ANTHROPIC_API_KEY, kept from .env) instead of the OpenAI-compatible gateway, which
# serves no claude model. Used by shape_opus5 and biomni_opus5. NOT for the cc/claude arm -- that one
# uses .claude_api.env (which SETS LLM_BASE_URL=api.anthropic.com for the Claude Code CLI).
#
# IMPORTANT: set the gateway base URLs to EMPTY, do NOT `unset` them. `shape` auto-loads the repo .env on
# import (python-dotenv), which RE-INJECTS LLM_BASE_URL into the process after any shell `unset` -- so an
# unset silently reverts and claude-* routes back to the gateway (404 model_not_found). An empty value is
# already "present", so dotenv's no-override leaves it empty, and factory.provider_of treats empty as
# "no gateway" -> claude-* -> anthropic. (Verified 2026-10-24.)
export LLM_BASE_URL=
export LLM_API_BASE=
