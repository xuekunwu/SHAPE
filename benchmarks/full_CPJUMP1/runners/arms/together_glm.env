# Sourced as $ARM_ENV AFTER the repo .env (run_staged.sh), so it wins. Points the reasoner at Together.ai's
# OpenAI-compatible endpoint for GLM (zai-org/GLM-5.3-Flash): shape's vision engine and biomni's "Custom"
# source both go through the OpenAI client with these. factory.provider_of routes the "zai-org/" prefix to
# 'openai', so it uses LLM_BASE_URL + LLM_API_KEY below (not 智谱/ZHIPUAI). SET (not unset) the base URL so
# python-dotenv's no-override keeps it (see arms/anthropic_direct.env for why unset would silently revert).
export LLM_BASE_URL=https://api.together.xyz/v1
export LLM_API_KEY=$TOGETHER_API_KEY
