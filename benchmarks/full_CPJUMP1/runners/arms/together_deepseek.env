# Sourced as $ARM_ENV AFTER the repo .env (run_staged.sh / run_staged_modality_probe.sh), so it wins.
# Points the reasoner at Together.ai's OpenAI-compatible endpoint for DeepSeek (deepseek-ai/DeepSeek-V4.1-
# Flash): shape's vision engine and biomni's "Custom" source both go through the OpenAI client with these.
# factory.provider_of routes the "deepseek-ai/" prefix to 'openai' (same mechanism as together_glm.env's
# "zai-org/" -> 'openai'), so it uses LLM_BASE_URL + LLM_API_KEY below. SET (not unset) the base URL so
# python-dotenv's no-override keeps it (see arms/anthropic_direct.env for why unset would silently revert).
# shape/engine/openai.py already special-cases deepseek-ai/ and qwen/ as "Together freeform" models (no
# response_format, verified against the live Together endpoint 2026-10-31) -- no further engine change
# needed here, this file only has to get the base URL/key routed.
export LLM_BASE_URL=https://api.together.xyz/v1
export LLM_API_KEY=$TOGETHER_API_KEY
